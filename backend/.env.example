# Server
PORT=4000
NODE_ENV=development
# Comma-separated Next.js origins allowed by CORS
CORS_ORIGIN=http://localhost:3000,https://thought-stack-ai.vercel.app

# Neon Postgres — pooled URL for the app (hostname includes "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon direct URL for Prisma migrate (same host WITHOUT "-pooler")
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Local Redis (docker compose up -d from repo root)
REDIS_URL=redis://localhost:6379

# Qdrant Cloud — cluster URL + API key from https://cloud.qdrant.io
QDRANT_URL=https://YOUR_CLUSTER_ID.REGION.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# OpenAI — embeddings (text-embedding-3-small) + gpt-4o-mini
OPENAI_API_KEY=sk-...

# Clerk (backend JWT verify) — same app as frontend
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase Storage — create a private bucket (default name: sources).
# Use the service role key on the server only (never expose to the browser).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=sources

# ElevenLabs — dual-voice podcast TTS (Text to Dialogue)
ELEVENLABS_API_KEY=sk_...
# Male host (default Adam) / female guest (default Sarah)
ELEVENLABS_HOST_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_GUEST_VOICE_ID=EXAVITQu4vr4xnSDxMaL
