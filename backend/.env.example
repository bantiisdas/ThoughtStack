# Server
PORT=4000
NODE_ENV=development
# Must match the Next.js origin
CORS_ORIGIN=http://localhost:3000

# Neon Postgres — pooled URL for the app (hostname includes "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon direct URL for Prisma migrate (same host WITHOUT "-pooler")
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Local infra (docker compose up -d from repo root)
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# OpenAI — embeddings (text-embedding-3-small) + gpt-4o-mini
OPENAI_API_KEY=sk-...

# Clerk (backend JWT verify) — same app as frontend
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Local file uploads (gitignored). Max 20 MB per file; 25 sources per notebook.
UPLOAD_DIR=uploads
