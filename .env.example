# Used by docker compose --profile https (Caddy). Copy to `.env` on the server.
# DNS A record for API_DOMAIN must point at this machine; open ports 80 + 443.

API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@example.com

# Frontend origin(s) for CORS (comma-separated). Used by the api service.
CORS_ORIGIN=https://thought-stack-ai.vercel.app,http://localhost:3000
